<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:minHeight="64dp"
    android:paddingStart="18dp" android:paddingEnd="18dp"
    android:paddingTop="12dp" android:paddingBottom="12dp"
    android:orientation="horizontal" android:background="@drawable/settings_preview_row">
    <ImageView android:id="@+id/infoIcon" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="12dp" android:layout_marginTop="3dp" android:contentDescription="@null" android:src="@drawable/settings_info" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/infoLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="#FFBDBDC7" android:fontFamily="@font/outfit_regular" />
    <TextView android:id="@+id/infoValue" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textSize="17sp" android:textColor="#FFF5F5FA"
        android:fontFamily="@font/outfit_regular" android:breakStrategy="simple" />
    </LinearLayout>
</LinearLayout>
